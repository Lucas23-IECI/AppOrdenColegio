# Neon Free. Server secrets must never use the VITE_ prefix.
BACKEND_PROVIDER=neon
VITE_BACKEND_PROVIDER=neon
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=verify-full
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH_STORAGE_ENDPOINT
AWS_ACCESS_KEY_ID=YOUR_STORAGE_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_PRIVATE_STORAGE_KEY
AWS_REGION=us-east-2
S3_BUCKET=evidence

# Optional legacy Supabase fallback. Set both provider variables to supabase.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Optional, only for compatibility with the old setup endpoint.
INITIAL_SETUP_KEY=

# Public configuration compiled into the browser app.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
